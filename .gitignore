# --- raw source data: large; re-download with scripts/01_download_raw.py or unzip GeoAI_raw.zip into raw/
raw/

# --- intermediate files regenerated by the scripts (pickles etc.)
data/cache/

# --- old / debug / backup material
archive/
*.zip
*backup*
*.bak
*.pre_*

# --- python / OS
__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# --- secrets: never commit (the live fetcher reads an optional MTA_API_KEY from the environment, not from a file)
.env
*.env
*key*
*secret*
*token*
*.pem

# --- live-fetch data and logs stay on the machine that runs the fetcher
live/raw/
live/*.log
live/*.out
live/live_log*.csv
